# Скопируйте этот файл в .env и заполните значения.
# Файл .env добавлен в .gitignore и не должен попадать в Git или в логи.

# --- Основной провайдер: DeepSeek (OpenAI-совместимый API) ----------------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Параметры запроса ----------------------------------------------------
# temperature: 0 — максимально строго, 1 — максимально свободно
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
# таймаут одного запроса в секундах
LLM_TIMEOUT=60
# просить у модели JSON-режим (true почти для всех современных провайдеров)
LLM_JSON_MODE=true

# --- Вариант с локальной Ollama (ключ не нужен, но поле должно быть непустым) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
